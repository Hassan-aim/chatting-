# PostgreSQL
POSTGRES_USER=chat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=private_chat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chat:changeme@localhost:5432/private_chat
DATABASE_URL_SYNC=postgresql+psycopg://chat:changeme@localhost:5432/private_chat

# JWT — generate a long random secret for production
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
MAX_UPLOAD_SIZE=52428800
STORAGE_TYPE=local
STORAGE_PATH=./storage
# Future: s3 / r2 / minio
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
API_RATE_LIMIT_PER_MINUTE=120

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
